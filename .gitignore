# --- Credenciales y configuración con datos reales -------------------
# NUNCA subir estos archivos: contienen WiFi, usuarios y contraseñas
# MQTT reales. Usar las versiones .example como plantilla pública.
config.h
crear_usuario_mqtt.bat
**/secrets.h
**/*_credentials.*

# Certificados y llaves TLS reales generados localmente
*.crt
*.key
*.pem
!**/*.example.crt
!**/*.example.key
mosquitto/certs/
mosquitto/passwd

# --- Binarios y artefactos de compilación -----------------------------
*.bin
*.hex
*.elf
*.map
*.o
*.obj
build/
.pio/
.pioenvs/
.piolibdeps/

# --- Entorno de desarrollo (Arduino IDE / PlatformIO / VS Code) -------
.vscode/
*.code-workspace
sketch_*/

# --- Sistema operativo --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs y archivos temporales -----------------------------------------
*.log
*.tmp
~$*.docx
~$*.xlsx

# --- Archivos de Fritzing generados automáticamente ----------------------
*.fzz.bak
*.fzz.lck
